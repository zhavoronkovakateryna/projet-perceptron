fig, axes = plt.subplots(2, len(FILES), figsize=(14, 8))

for col_idx, method in enumerate(predictions):
    y_pred    = predictions[method]
    residuals = y_true - y_pred

    # --- ligne 1 : histogramme + KDE + Gaussienne ---
    ax_hist = axes[0, col_idx]
    ax_hist.set_title(f"{method}")
    ax_hist.hist(residuals, bins=20, density=True,
                 color="steelblue", edgecolor="white",
                 linewidth=0.8, alpha=0.8, label="Résidus")

    # KDE
    from scipy.stats import gaussian_kde
    kde = gaussian_kde(residuals)
    xs  = np.linspace(residuals.min(), residuals.max(), 200)
    ax_hist.plot(xs, kde(xs), color="red", linewidth=2, label="KDE")

    # --- Courbe gaussienne théorique ---
    mu = np.mean(residuals)
    sigma = np.std(residuals)

    from scipy.stats import norm
    gauss = norm.pdf(xs, loc=mu, scale=sigma)
    ax_hist.plot(xs, gauss, color="black", linestyle="--",
                 linewidth=2, label="Gaussienne")

    ax_hist.axvline(0, color="green", linestyle="--", linewidth=1.5, label="Zéro")
    ax_hist.axvline(mu, color="orange", linestyle=":",
                    linewidth=1.5, label=f"Moy={mu:.3f}")

    ax_hist.set_xlabel("Résidu")
    ax_hist.grid(True, alpha=0.3)
    ax_hist.legend(fontsize=7)

    if col_idx == 0:
        ax_hist.set_ylabel("Densité")

    # --- ligne 2 : résidus vs y_pred 
