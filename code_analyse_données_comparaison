X_test = pd.read_csv("boston_inputs_test.csv").values
y_true = pd.read_csv("boston_outputs_test.csv").values.flatten()

# =========================================================
# AJOUT DU BIAS
# =========================================================
X_test = np.hstack([np.ones((X_test.shape[0], 1)), X_test])

# =========================================================
# MODELE MLP (tanh, tanh, linéaire)
# =========================================================
def predict(X, theta0, theta1, theta2):

    # 🔥 correction automatique des dimensions
    if X.shape[1] != theta0.shape[0]:
        theta0 = theta0.T

    if theta0.shape[1] != theta1.shape[0]:
        theta1 = theta1.T

    if theta1.shape[1] != theta2.shape[0]:
        theta2 = theta2.T

    # Couche 1
    z1 = X @ theta0
    a1 = np.tanh(z1)

    # Couche 2
    z2 = a1 @ theta1
    a2 = np.tanh(z2)

    # Sortie
    z3 = a2 @ theta2
    y_pred = z3

    return y_pred.flatten()

# =========================================================
# COMPARAISON DES ERREURS PAR POINT
# =========================================================
error_data = []

for method, df in datasets.items():

    # meilleur run
    best_idx = df["cout_final"].idxmin()
    best_run = df.loc[best_idx]

    theta0 = best_run["theta0"]
    theta1 = best_run["theta1"]
    theta2 = best_run["theta2"]

    # prédiction
    y_pred = predict(X_test, theta0, theta1, theta2)

    # erreur absolue
    abs_error = np.abs(y_pred - y_true)

    for i, err in enumerate(abs_error):
        error_data.append({
            "method": method,
            "point": i,
            "abs_error": err
        })

error_df = pd.DataFrame(error_data)

# =========================================================
# ANALYSE PAR POINT
# =========================================================
pivot_errors = error_df.pivot(index="point", columns="method", values="abs_error")

# meilleure méthode par point
pivot_errors["best_method"] = pivot_errors.idxmin(axis=1)

