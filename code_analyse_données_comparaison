# =========================================================
# 11) TESTS STATISTIQUES DE WILCOXON (PAIRWISE)
# =========================================================
# Le test de Wilcoxon signed-rank est adapté ici car les runs
# partagent les mêmes seeds (données appariées).
# H0 : les deux distributions de coût sont identiques.
# Si p < 0.05, la différence entre les deux méthodes est
# statistiquement significative.

methods = list(FILES.keys())

print("\n==============================")
print("TESTS DE WILCOXON (comparaisons par paires)")
print("Seuil de significativité : α = 0.05")
print("==============================")

wilcoxon_rows = []

for i in range(len(methods)):
    for j in range(i + 1, len(methods)):
        m1, m2 = methods[i], methods[j]
        costs1 = datasets[m1]["cout_final"].values
        costs2 = datasets[m2]["cout_final"].values

        stat, p = wilcoxon(costs1, costs2)
        significant = p < 0.05

        print(
            f"  {m1} vs {m2} : W = {stat:.2f}, p = {p:.4f}  "
            f"{'→ différence SIGNIFICATIVE ✅' if significant else '→ différence non significative ❌'}"
        )

        wilcoxon_rows.append({
            "comparaison":   f"{m1} vs {m2}",
            "W":             stat,
            "p_value":       p,
            "significatif":  significant
        })

wilcoxon_table = pd.DataFrame(wilcoxon_rows)

# =========================================================
# 12) COMPARAISON PAR POINT (DONNEES DE TEST)
# =========================================================

X_test = pd.read_csv("boston_inputs_test.csv").values
y_true = pd.read_csv("boston_outputs_test.csv").values.flatten()

# Ajout du biais (colonne de 1)
X_test = np.hstack([np.ones((X_test.shape[0], 1)), X_test])

error_data   = []
metrics_rows = []
predictions  = {}

for method, df in datasets.items():
    best_idx = df["cout_final"].idxmin()
    best_run = df.loc[best_idx]

    y_pred = predict(X_test, best_run["theta0"], best_run["theta1"], best_run["theta2"])
    predictions[method] = y_pred

    abs_error = np.abs(y_pred - y_true)
    for i, err in enumerate(abs_error):
        error_data.append({"method": method, "point": i, "abs_error": err})

    metrics_rows.append({
        "Méthode": method,
        "MSE":     mean_squared_error(y_true, y_pred),
        "RMSE":    np.sqrt(mean_squared_error(y_true, y_pred)),
        "MAE":     mean_absolute_error(y_true, y_pred),
        "R²":      r2_score(y_true, y_pred),
    })

error_df = pd.DataFrame(error_data)
metrics_df = pd.DataFrame(metrics_rows).set_index("Méthode")

print("\n==============================")
print("MÉTRIQUES DE PERFORMANCE SUR LE JEU DE TEST (meilleur run)")
print("==============================")
print(metrics_df.to_string())

pivot_errors = error_df.pivot(index="point", columns="method", values="abs_error")
pivot_errors["best_method"] = pivot_errors.idxmin(axis=1)

