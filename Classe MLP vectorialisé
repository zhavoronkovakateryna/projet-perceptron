class MLP:
    """= np.array([ np.array([ np.array([ 1 for neurone in range(len(nb_neurone_par_couche[couche]))] for couche in range(len(nb_neurone_par_couche))) ])])"""
    def __init__(self, nb_neurone_par_couche, fonction_couche, derivé_fonction_couche, theta_neurone_couche ): 
        """
        Fonction d'initialisation d'un neurones du réseau MLP

        Parameters
        ----------
       nb_neurone_par_couche : list
           de la forme [nb_neurone_couche_1,nb_neurone_couche_2,..].
       fonction_couche : list
           de la forme [fonction_couche_1,fonction_couche_2,..].
       derivé_fonction_couche : list
           de la forme [dérivé_fonction_couche_1,dérivé_fonction_couche_2,..].
       theta_neurone_couche : array(array(array([ ])))
           de la forme [ [ [N_1_1],..], [[N_2_1],..], .. ].

        Returns
        -------
        None.
        """
        self.taille = nb_neurone_par_couche
        self.fonction_couche = fonction_couche
        self.derivé_fonction_couche = derivé_fonction_couche
        self.theta = theta_neurone_couche
        self.data = np.array([])
        self.delta = 0
        self.gradient = 0
        self.valeur_fonction = np.array([0 for n in range(len(nb_neurone_par_couche))])
        self.valeur_Z = np.array([])
        
    def __repr__(self):
        return f"|taille : {self.taille} __ paramètre : {self.theta}|"

    def data_entry(self)->None:
        """
        Fonction demandant et affecte le array au perceptron <self>

        Returns
        -------
        None.
        """
        data = eval(input('Transmettez vos données: '))
        self.data = np.array(data)                                             #data est une liste des couples(entree, sortie attendue)
        
    def propa_avant(self, entrée):
        """
        Fait la propagation avant de tout le reseaux avec <entrée> comme entrée du réseaux

        Parameters
        ----------
        entrée : array
            entrée considérée pour le réseau

        Returns
        -------
        None.
        """
        nb_couche = len(self.taille)
        sortie_couche = np.array([])
        X = entrée + np.array([1])                              #ajout de 1 au array pour le produit matriciel du biais qui est présent dans X
        for couche in range(nb_couche):
            W = self.theta[couche]
            sortie_couche = W @ X
            self.valeur_fonction[couche] = sortie_couche
            X = sortie_couche + np.array([1])  
        return None
    def delta_fin(self, Xi):
        couche = len(self.taille)
    
        # Propagation avant sur l'entrée
        self.propa_globale(Xi[0])
    
        # Sortie du réseau
        X_fin = self.valeur_fonction[-1]
    
        # Dérivée de la fonction d'activation sur la dernière couche
        derive = self.derive_fonction_couche[-1](np.array(self.valeur_Z[-1], dtype=float))
    
        # Delta de la dernière couche
        delta = (np.array(X_fin, dtype=float) - np.array(Xi[1], dtype=float)) * derive
    
        # Mise à jour de l'attribut delta
        self.delta = delta
    
        return delta

    def propa_arrière(self, couche):                                    #marche mais à vectorialiser
        """
        Fait la propagation arrière d'une couche du reseaux en mettant à jour les deltas de <couche>

        Parameters
        ----------
        Z_vect : list
            entrée de la couche considérée.
        couche : int
            n° de la couche d'avant.
        reseaux : dict
            reseaux MLP.

        Returns
        -------
        None
        """
        delta = np.zeros(self.taille[couche - 1], dtype=float)
    
        for i in range(self.taille[couche - 1]):
            for j in range(self.taille[couche]):
                delta[i] += (
                    self.delta[couche][j]
                    * self.theta[couche][j][i]
                    * self.derive_fonction_couche[couche - 1](self.valeur_Z[couche - 1][i])
                )
    
        self.delta[couche - 1] = delta
    
        
        
        
    
    
