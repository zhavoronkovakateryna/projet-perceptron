# -*- coding: utf-8 -*-
import numpy as np
# ────────────────────────────────────────────────
# Fonctions d'activation
# ────────────────────────────────────────────────
def sigmoid(x): 
    return 1/(1+np.exp(x))

def ReLU(x):
    return np.maximum(0, x)

def d_sigmoid(x): 
    return sigmoid(x) * (1 - sigmoid(x))

def d_ReLU(x):
    grad = np.zeros_like(x)
    grad[x > 0] = 1
    grad[x == 0] = 0.5
    return grad

# ────────────────────────────────────────────────
# Fonction de coût (MSE)
# ────────────────────────────────────────────────
def mse(y_pred, y_true):
    return 0.5 * np.mean((y_pred - y_true) ** 2)

# ────────────────────────────────────────────────
# Création du réseau
# ────────────────────────────────────────────────
def creer_mlp(nb_neurones_par_couche, activations, d_activations, dim_entree, theta_initial):
    return {
        "couches": nb_neurones_par_couche,
        "activations": activations,
        "d_activations": d_activations,
        "Theta": [np.array(W, dtype=float) for W in theta_initial],
        "Z": [],
        "A": [],
        "deltas": []
    }

# ────────────────────────────────────────────────
# Propagation avant
# ────────────────────────────────────────────────
def propa_globale(X, reseaux):
    reseaux["A"] = [np.array(X)]
    reseaux["Z"] = []

    a = reseaux["A"][0]                                                        #a pour activation

    for W, f in zip(reseaux["Theta"], reseaux["activations"]):
        a_bias = np.append(a, 1.0)          # ajout biais
        z = np.dot(W, a_bias)
        a = f(z)

        reseaux["Z"].append(z)
        reseaux["A"].append(a)

    return a

# ────────────────────────────────────────────────
# Rétropropagation
# ────────────────────────────────────────────────
def delta_global(data_point, reseaux):
    X, Y = data_point
    propa_globale(X, reseaux)

    z_L = reseaux["Z"][-1]
    a_L = reseaux["A"][-1]

    delta = (a_L - np.array(Y)) * reseaux["d_activations"][-1](z_L)
    deltas = [delta]

    for i in reversed(range(len(reseaux["Theta"]) - 1)):
        W_next = reseaux["Theta"][i+1][:, :-1]  # sans biais
        z = reseaux["Z"][i]
        delta = np.dot(W_next.T, delta) * reseaux["d_activations"][i](z)
        deltas.insert(0, delta)

    reseaux["deltas"] = deltas
    return deltas

# ────────────────────────────────────────────────
# Gradient (1 seul exemple)
# ────────────────────────────────────────────────
def gradient(data, reseaux):
    grad_total = [np.zeros_like(W) for W in reseaux["Theta"]]

    for x, y in data:
        delta_global((x, y), reseaux)
        for i in range(len(reseaux["Theta"])):
            a_prev = np.append(reseaux["A"][i], 1.0)
            grad_total[i] += np.outer(reseaux["deltas"][i], a_prev)

    return [g / len(data) for g in grad_total]

# ────────────────────────────────────────────────
# DEBUG complet
# ────────────────────────────────────────────────
def debug_un_exemple(x, y, reseaux):
    print("\n==============================")
    print("        PROPAGATION AVANT")
    print("==============================")
    
    propa_globale(x, reseaux)
    
    for i in range(len(reseaux["Theta"])):
        print(f"\nCouche {i+1}")
        print("Z =", reseaux["Z"][i])
        print("A =", reseaux["A"][i+1])
    
    print("\n==============================")
    print("     RETROPROPAGATION")
    print("==============================")
    
    deltas = delta_global((x, y), reseaux)
    
    for i, d in enumerate(deltas):
        print(f"Delta couche {i+1} =", d)
    
    print("\n==============================")
    print("         GRADIENTS")
    print("==============================")
    
    grads = gradient([(x, y)], reseaux)
    
    for i, g in enumerate(grads):
        print(f"\nGradient Couche {i+1} =\n{g}")
    
    print("\n==============================")
    print("         Ycal_reseaux - Yref")
    print("==============================")
    print(reseaux["A"][2][0] - y[0])
    
    print("\n==============================")
    print("         MSE")
    print("==============================")
    print(mse(reseaux["A"][2], y[0]))

