import numpy as np
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D

# ============================================================
# Carte de sensibilité "GD" pour MLP_these (style thèse)
# Dépend de TES fonctions déjà définies : gradient(), R(), etc.
# ============================================================

# --- Couleurs EXACTES (convention thèse) ---
# (-2, 1) -> bleu ; (2, -1) -> cyan ; (0, -1) -> vert ; (0, 1) -> violet ; NonConv -> rouge
COLOR_MAP = {
    "(-2,1)"  : (0.0, 0.0, 1.0),   # blue
    "(2,-1)"  : (0.0, 1.0, 1.0),   # cyan
    "(0,-1)"  : (0.0, 1.0, 0.0),   # green
    "(0,1)"   : (0.6, 0.0, 0.8),   # violet
    "NonConv" : (1.0, 0.0, 0.0),   # red
}

# Points critiques utilisés dans la thèse pour PolyGlobalMild (mêmes 4 minimums) :contentReference[oaicite:1]{index=1}
CRITICAL_POINTS = {
    "(-2,1)" : np.array([-2.0,  1.0]),
    "(2,-1)" : np.array([ 2.0, -1.0]),
    "(0,-1)" : np.array([ 0.0, -1.0]),
    "(0,1)"  : np.array([ 0.0,  1.0]),
}

def _train_GD_from_theta0(MLP_these, data_these, theta0, eta=0.1, eps=1e-5, n_max=200000):
    """
    Lance un GD à pas constant depuis theta0=(w0,b0) sur TON MLP_these.
    Renvoie (theta_final, converged_bool, diverged_bool).
    """
    theta = np.array(theta0, dtype=float)

    # impose theta0 au neurone unique
    MLP_these["N_1_1"]["theta"] = theta.copy()

    for _ in range(n_max):
        g = gradient(data_these, MLP_these)

        if (not np.all(np.isfinite(g))) or (not np.all(np.isfinite(theta))):
            return theta, False, True

        if np.linalg.norm(g) < eps:
            return theta, True, False

        theta = theta - eta * g
        MLP_these["N_1_1"]["theta"] = theta.copy()

        # divergence si le coût devient inf/nan
        valR = R(data_these, MLP_these)
        if (not np.isfinite(valR)):
            return theta, False, True

    # n_max atteint -> NonConv
    return theta, False, False

def _label_by_nearest_critical(theta, tol=5e-2):
    """
    Associe theta au minimum critique le plus proche (4 minima).
    Si trop loin -> NonConv.
    """
    theta = np.array(theta, dtype=float)
    best_name = None
    best_dist = 1e18
    for name, pt in CRITICAL_POINTS.items():
        d = np.linalg.norm(theta - pt)
        if d < best_dist:
            best_dist = d
            best_name = name
    return best_name if best_dist <= tol else "NonConv"

def carte_sensibilite_GD_these(MLP_these, data_these,
                              N=10000, borne=3.0,
                              eta=0.1, eps=1e-5, n_max=200000,
                              tol_crit=5e-2, seed=0,
                              draw_contours=True, contour_grid=250):
    """
    Produit une carte comme la figure GD de la thèse :
    - nuage de points initiaux colorés selon le minimum critique atteint
    - rouge si NonConv
    - isolignes vertes optionnelles
    """
    rng = np.random.default_rng(seed)
    inits = rng.uniform(-borne, borne, size=(N, 2))  # (w0,b0)

    X = np.empty(N)
    Y = np.empty(N)
    C = np.empty((N, 4))

    for k, (w0, b0) in enumerate(inits):
        theta_f, ok, div = _train_GD_from_theta0(
            MLP_these, data_these, (w0, b0),
            eta=eta, eps=eps, n_max=n_max
        )
        if ok and (not div):
            lab = _label_by_nearest_critical(theta_f, tol=tol_crit)
        else:
            lab = "NonConv"

        X[k] = w0
        Y[k] = b0
        C[k] = (*COLOR_MAP[lab], 1.0)

    plt.figure(figsize=(6.2, 6.0))
    plt.scatter(X, Y, s=6, c=C, marker='o', linewidths=0)

    # Isolignes vertes du coût (comme indiqué dans la thèse) :contentReference[oaicite:2]{index=2}
    if draw_contours:
        ws = np.linspace(-borne, borne, contour_grid)
        bs = np.linspace(-borne, borne, contour_grid)
        W, B = np.meshgrid(ws, bs)
        RR = np.zeros_like(W, dtype=float)

        for i in range(contour_grid):
            for j in range(contour_grid):
                MLP_these["N_1_1"]["theta"] = np.array([W[i, j], B[i, j]], dtype=float)
                RR[i, j] = R(data_these, MLP_these)

        # niveaux (évite de saturer avec des valeurs extrêmes)
        vmax = np.percentile(RR[np.isfinite(RR)], 80)
        vmin = np.min(RR[np.isfinite(RR)])
        levels = np.linspace(vmin, vmax, 8)
        plt.contour(W, B, RR, levels=levels, colors="green", linewidths=0.8, alpha=0.9)

    plt.xlim(-borne, borne)
    plt.ylim(-borne, borne)
    plt.xlabel("w")
    plt.ylabel("b")
    plt.xticks([-3, -2, -1, 0, 1, 2, 3])
    plt.yticks([-3, -2, -1, 0, 1, 2, 3])
    plt.grid(False)

    # Légende (même libellés que la thèse)
    legend_handles = [
        Line2D([0], [0], marker='o', color='w', label='(-2,1)',
               markerfacecolor=COLOR_MAP["(-2,1)"], markersize=7),
        Line2D([0], [0], marker='o', color='w', label='(2,-1)',
               markerfacecolor=COLOR_MAP["(2,-1)"], markersize=7),
        Line2D([0], [0], marker='o', color='w', label='(0,-1)',
               markerfacecolor=COLOR_MAP["(0,-1)"], markersize=7),
        Line2D([0], [0], marker='o', color='w', label='(0,1)',
               markerfacecolor=COLOR_MAP["(0,1)"], markersize=7),
        Line2D([0], [0], marker='o', color='w', label='NonConv',
               markerfacecolor=COLOR_MAP["NonConv"], markersize=7),
    ]
    plt.legend(handles=legend_handles, loc="lower right", frameon=True)

    plt.title("GD")
    plt.tight_layout()
    plt.show()


