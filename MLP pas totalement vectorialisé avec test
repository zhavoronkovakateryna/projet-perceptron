        for j in range(reseaux["couche"][couche]):
            delta[i]+=reseaux[f"N_{couche+1}_{j+1}"]["delta"] * reseaux[f"N_{couche+1}_{j+1}"]["theta"][i] * reseaux["dérivé_fonction"][couche-1](reseaux["valeur_Z"][couche-1][i])
            #print(reseaux[f"N_{couche+1}_{j+1}"]["delta"])                    #reseaux[f"N_{couche+1}_{j+1}"]["theta"][i] = wij ^ (couche)
            #print(reseaux[f"N_{couche+1}_{j+1}"]["theta"][i])
            #print(reseaux["valeur_Z"][couche-1][i][j])
    #print(delta)                                    
                                   
    for num_neurone in range(reseaux["couche"][couche-1]):                     #attribution des deltas aux neurones à la couche <couche>
       reseaux[f"N_{couche}_{num_neurone+1}"]["delta"]=delta[num_neurone]
    return None

def delta_global(data, reseaux):
    """
    Met à jour tous les deltas du réseaux 
    
    Parameters
    ----------
    reseaux : dict
        DESCRIPTION.
    data : list de couple
        les donnée considérées pour l'entraînement du MLP.

    Returns
    -------
    None.
    """
    n=len(reseaux["couche"])
    delta_fin(data, reseaux) 
    for i in range(1,n):                                                       #autant de tour qu'il y a de <couche-1> car delta dernière couche est calculé différement
        propa_arrière(data[0], n-i, reseaux)
    return None

def gradient_a_pas_constant(data, reseaux)->None:                               #marche mais à vectorialiser
    """
    Fonction réalisant la minimisation de la fonction de coût R(theta) associée
    au reseaux par la méthode de descente de gradient à pas constant en les mettant à jour

    Parameters
    ----------
    data : list de couple
        Donnée avec lesquels on entraîne le reseaux.

    Returns
    -------
    None
    """
    theta = np.array([reseaux[f"N_{couche+1}_{emplacement+1}"]["theta"][wb] for couche in range(len(reseaux["couche"])) 
                      for emplacement in range(reseaux["couche"][couche]) for wb in range(len(reseaux[f"N_{couche+1}_{emplacement+1}"]["theta"]))] )                                
    epsilon = 1e-4                                                             #les thetas sont l'ordre suivant : theta du neurone en couche 1 emplacement 1 (1_1),  
    eta = 1e-2                                                                 #theta du neurone en couche 1 emplacement 2 (1_2),...,theta du neurone en couche L emplacement nL (L_nL)
    n_max = 1000
    
    for _ in range(n_max):
        attribution=0                                                          #compteur pour réatribuer les poids et biais à chaque neurones
        grad = gradient(data, reseaux)
        if np.linalg.norm(grad) <= epsilon:
            #print("sortie")
            break
        theta = theta - eta * grad
        #print(theta)
        for couche in range(len(reseaux["couche"])):                           #mise à jour des theta de tous les neurones du réseaux
            nombre_param=len(reseaux[f"N_{couche+1}_1"]["theta"])
            for emplacement in range(reseaux["couche"][couche]):
                #print("theta : ",end="")
                #print(theta[attribution:attribution+nombre_param])
                reseaux[f"N_{couche+1}_{emplacement+1}"]["theta"]=theta[attribution:attribution+nombre_param]
                attribution+=nombre_param
        #affichage(MLP)
    return None

def gradient(data, reseaux)->np.array :                                         #marche mais à vectorialiser
    """
    Fonction réalisant le gradient de la fonction de coût R(theta) associée
    au reseaux 

    Parameters
    ----------
    data : list de couple
        Donnée avec lesquels on entraîne le reseaux.

    Returns
    -------
    np.array
        les gradients de tous les paramètres du reseaux
    """
    grad=[0 for couche in range(len(reseaux["couche"])) for emplacement in range(reseaux["couche"][couche]) 
          for wb in range(len(reseaux[f"N_{couche+1}_1"]["theta"])) ]
    for D in data:
        attrib=0
        delta_global(D, reseaux)
        for couche in range(len(reseaux["couche"])):
            if couche==0:
                entree=D[0]+[1]   
            else:
                entree=np.concatenate((reseaux["valeur_fonction"][couche-1], np.array([1])), axis=0)
            #print(entree)
            
            for emplacement in range(reseaux["couche"][couche]):
                for k in range(len(entree)):
                    grad[attrib]+=reseaux[f"N_{couche+1}_{emplacement+1}"]["delta"]*np.array(entree)[k]
                    attrib+=1
                #print(reseaux[f"N_{couche+1}_{emplacement+1}"]["delta"]*np.array(entree))
                
    return np.array(grad)/len(data)
   
    
