def R(reseaux, data):
    """
    Fonction de coût du réseaux pour les datas <data>

    Parameters
    ----------
    reseaux : dict
        Réseau 'MLP'.
    data : list de couple
        de la forme [(X1,Y1), (X2,Y2),]
    Returns
    -------
    float
        coût.
    """
    n=len(data)
    cout_glo=sum([r(reseaux,X_Y_i) for X_Y_i in data])/n
    return cout_glo
        
def z(reseaux, nom, Xi):
    """
    Calcule zn = w·xn + b.
    """
    w = reseaux[nom]["theta"][:-1]
    b = reseaux[nom]["theta"][-1]
    xn = np.array(Xi)
    return np.dot(w, xn) + b

def Z_vect(reseaux, couche, Xi):
    """
    Vectorialise tous les zi de la couche <couche> en Z 

    Parameters
    ----------
    reseaux : dict
        le reseaux MLP.
    couche : int
        n° de la couche des zi à vectorialiser.
    Xi : list
        entrée de la couche.

    Returns
    -------
    Z : list
        tous les zi de la couche <couche>.
    """
    #print(Xi)
    Z = [z(reseaux, nom, Xi) for nom in reseaux.keys()
        if nom[:2] == "N_" and reseaux[nom]["position"][0] == couche]
    return Z

def propa_avant(Z_vect, couche, reseaux):
    """
    Fait la propagation avant d'une couche du reseaux

    Parameters
    ----------
    Z_vect : list
        DESCRIPTION.
    couche : int
        DESCRIPTION.
    reseaux : dict
        DESCRIPTION.

    Returns
    -------
    array
        array correspondant à G^(couche) (Z_vect).
    """
    return reseaux["fonction"][couche-1](np.array(Z_vect))                     #Calcule g^(couche)(Z_vect)

def propa_globale(Z_vecteur, reseaux):
    """
    Fait la propagation avant de tout le reseaux avec <Z> comme entrée du réseaux

    Parameters
    ----------
    Z_vecteur : list
        le X^(0)
    reseaux : dict
        le reseaux MLP.

    Returns
    -------
    None.
    """
    G_glo=[0 for i in range(len(reseaux["couche"]))]
    Z_glo=[0 for i in range(len(reseaux["couche"]))]                           
    for i in range(len(reseaux["couche"])):
        Z_vecteur = Z_vect(reseaux, i+1, Z_vecteur)
        #print("Z_vecteur : ",end="")
        #print(Z_vecteur)
        Z_glo[i] = Z_vecteur
        G = propa_avant(Z_vecteur, i+1, reseaux)
        Z_vecteur = G
        G_glo[i]=Z_vecteur
    #print(G_glo)
    #print("Z_glo : ",end="")
    #print(Z_glo)
    reseaux["valeur_fonction"]=G_glo                                           #list(list ) contenant la valeur de tous les fonction(Z) ,peut etre à enlever
    reseaux["valeur_Z"]=Z_glo                                                  #list(list ) contenant la valeur de tous les Z
    return None

def delta_fin(Xi, reseaux):
    """
    Calcul le delta^(L) du réseaux <reseaux> pour <Xi> et le met à jour

    Parameters
    ----------
    Xi : list de couple
        les datas considérées pour le delta de la forme [(X1,Y1), (X2,Y2),].
    reseaux : dict
        reseaux MLP.

    Returns
    -------
    delta : array
        delta^(L) sous forme de 'vecteur' .
    """
    couche=len(reseaux["couche"])
    
    #print("Xi : ",end="")
    #print(Xi[0][0])
    propa_globale(Xi[0], reseaux)
    X_fin = reseaux["valeur_fonction"][-1]
    derive=X_fin*(1-X_fin)                           #reseaux["dérivé_fonction"][couche-1](np.array(reseaux["valeur_Z"][-1]))
    #print(X_fin)
    #print(derive)
    delta = (X_fin - np.array(Xi[1], dtype=float)) * derive                    #Formule donnée par le prof pour delta dernière couche
    for num_neurone in range(reseaux["couche"][-1]):                           #attribution des deltas aux neurones de la dernière couche
        reseaux[f"N_{couche}_{num_neurone+1}"]["delta"]=delta[num_neurone]
    return delta

def propa_arrière(Z_vect, couche, reseaux):                                    #marche mais à vectorialiser
