# ────────────────────────────────────────────────
# Génération des 32 theta0 Xavier pour Diamonds
# dims : (in, out) de chaque couche de poids
# ────────────────────────────────────────────────
def gen_theta_xavier(seed, dims=[(9, 30), (30, 30), (30, 1)]):
    np.random.seed(seed)
    return [
        np.random.uniform(-np.sqrt(6 / (i + o)), np.sqrt(6 / (i + o)), (o, i + 1))
        for (i, o) in dims
    ]

theta0_list = [gen_theta_xavier(seed) for seed in range(32)]

# ════════════════════════════════════════════════
# CAMPAGNE DISTRIBUÉE
# ════════════════════════════════════════════════
# ← SEULE LIGNE À CHANGER PAR PC
PC_ID = 0
mes_runs = [0, 1, 2, 3]
# PC1 → [4,  5,  6,  7]
# PC2 → [8,  9,  10, 11]
# PC3 → [12, 13, 14, 15]
# PC4 → [16, 17, 18, 19]
# PC5 → [20, 21, 22, 23]
# PC6 → [24, 25, 26, 27]
# PC7 → [28, 29, 30, 31]

resultats  = []   # une ligne par run  → CSV principal
ecarts_all = []   # une ligne par point de test → CSV détaillé

for i in mes_runs:
    reseaux = creer_mlp(
        nb_neurones_par_couche=[30, 30, 1],
        activations=[gelu, gelu, identite],
        d_activations=[dgelu, dgelu, didentite],
        theta_initial=theta0_list[i],
        dim_entree=9
    )
    reseaux, couts, etas = entrainer_avec_backtracking(
        data=data_train,
        reseaux=reseaux,
        eta0=0.01,
        n_max=3000,
        batch_size=128,    # ← None pour revenir en full-batch
        verbose=False
    )

    preds       = np.array([propa_globale(x, reseaux)[0] for x, _ in data_test])
    y_test_reel = np.array([y[0] for _, y in data_test])
    ecarts      = np.abs(preds - y_test_reel)          # |ŷ - y| par point

    mae  = float(np.mean(ecarts))                      # = écart moyen du run
    rmse = np.sqrt(np.mean((preds - y_test_reel) ** 2))
    r2   = 1 - (rmse ** 2 / np.var(y_test_reel))

    # ── CSV principal : une ligne par run ──────────────────────────────────
    resultats.append({
        "run"         : i,
        "seed"        : i,
        "cout_final"  : round(couts[-1], 8),
        "ecart_moyen" : round(mae, 4),       # MAE = écart moyen
        "rmse"        : round(rmse, 4),
        "r2"          : round(r2,   6),
        "theta0"      : json.dumps(reseaux["Theta"][0].tolist()),
        "theta1"      : json.dumps(reseaux["Theta"][1].tolist()),
        "theta2"      : json.dumps(reseaux["Theta"][2].tolist()),
    })

    # ── CSV détaillé : une ligne par point de test ─────────────────────────
    for j, (pred_j, y_j, ecart_j) in enumerate(zip(preds, y_test_reel, ecarts)):
        ecarts_all.append({
            "run"       : i,
            "idx_test"  : j,
            "y_reel"    : round(float(y_j),     4),
            "y_pred"    : round(float(pred_j),  4),
            "ecart_abs" : round(float(ecart_j), 4),
        })

    print(f"Run {i:2d} | seed={i} | coût={couts[-1]:.6f} | "
          f"écart moyen={mae:.2f} | RMSE={rmse:.2f} | R²={r2:.4f}")

