# ────────────────────────────────────────────────
# Fonctions d'activation
# ────────────────────────────────────────────────
def sigmoid(x):   return 1 / (1 + np.exp(-x))
def dsigmoid(x):  return sigmoid(x) * (1 - sigmoid(x))
def identite(x):  return x
def didentite(x): return np.ones_like(x)
def relu(x):      return np.maximum(0, x)
def drelu(x):     return (x > 0).astype(float)
def tanh(x):      return np.tanh(x)
def dtanh(x):     return 1 - tanh(x) ** 2

from scipy.special import erf
def gelu(x):
    return x / 2 * (1 + erf(x / np.sqrt(2)))

def dgelu(x):
    return 0.5 * (1 + erf(x / np.sqrt(2))) + x * np.exp(-x**2 / 2) / np.sqrt(2 * np.pi)

# ────────────────────────────────────────────────
# Fonction de coût (MSE)
# ────────────────────────────────────────────────
def mse(y_pred, y_true):
    return 0.5 * np.mean((y_pred - y_true) ** 2)

# ────────────────────────────────────────────────
# Création du réseau
# ────────────────────────────────────────────────
def creer_mlp(nb_neurones_par_couche, activations, d_activations, dim_entree, theta_initial=None):
    reseaux = {
        "couches"      : nb_neurones_par_couche,
        "activations"  : activations,
        "d_activations": d_activations,
        "Theta"        : [],
        "Z"            : [],
        "A"            : [],
        "deltas"       : []
    }

    if theta_initial is not None:
        for W in theta_initial:
            reseaux["Theta"].append(np.array(W, dtype=float))
    else:
        prev = dim_entree
        for n in nb_neurones_par_couche:
            std = np.sqrt(2 / (prev + n))
            W = np.random.randn(n, prev + 1) * std
            reseaux["Theta"].append(W)
            prev = n

    return reseaux

# ────────────────────────────────────────────────
# Propagation avant
# ────────────────────────────────────────────────
def propa_globale(X, reseaux):
    reseaux["A"] = [np.asarray(X)]
    reseaux["Z"] = []
    activation = reseaux["A"][0]

    for W, f in zip(reseaux["Theta"], reseaux["activations"]):
        entree_avec_biais = np.append(activation, 1.0)
        z = np.dot(W, entree_avec_biais)
        activation = f(z)
        reseaux["Z"].append(z)
        reseaux["A"].append(activation)

    return activation

# ────────────────────────────────────────────────
# Rétropropagation
# ────────────────────────────────────────────────
def delta_global(data_point, reseaux):
    X, Y = data_point
    propa_globale(X, reseaux)

    z_L    = reseaux["Z"][-1]
    a_L    = reseaux["A"][-1]
    delta  = (a_L - np.asarray(Y)) * reseaux["d_activations"][-1](z_L)
    deltas = [delta]

    for i in reversed(range(len(reseaux["Theta"]) - 1)):
        W_next = reseaux["Theta"][i + 1][:, :-1]
        z_curr = reseaux["Z"][i]
        delta  = np.dot(W_next.T, delta) * reseaux["d_activations"][i](z_curr)
        deltas.insert(0, delta)

    reseaux["deltas"] = deltas
    return deltas

# ────────────────────────────────────────────────
# Gradient moyen (sur un sous-ensemble ou tout le dataset)
# ────────────────────────────────────────────────
def gradient(data, reseaux):
    grad_total = [np.zeros_like(W) for W in reseaux["Theta"]]

    for x, y in data:
        delta_global((x, y), reseaux)
        for i in range(len(reseaux["Theta"])):
            a_prev = np.append(reseaux["A"][i], 1.0)
            grad_total[i] += np.outer(reseaux["deltas"][i], a_prev)

    return [g / len(data) for g in grad_total]

# ────────────────────────────────────────────────
# Entraînement avec backtracking (+ mini-batch optionnel)
# ────────────────────────────────────────────────
def entrainer_avec_backtracking(data, reseaux,
                                eta0=0.5,
                                n_max=5000,
                                reduction=0.5,
                                batch_size=None,   # None = full-batch
                                verbose=True):
    # Le coût de référence et les tracés sont toujours calculés sur le
    # dataset COMPLET pour rester comparables entre runs.
    couts = []
    etas  = []
    current_cost = sum(mse(propa_globale(x, reseaux), y) for x, y in data) / len(data)
    couts.append(current_cost)

    if verbose:
        mode = f"mini-batch {batch_size}" if batch_size else "full-batch"
        print(f"It 0 | coût = {current_cost:.6f} | η initial = {eta0} | mode = {mode}")

    eta       = eta0
    data_list = list(data)

    for it in range(1, n_max + 1):

        # ── Tirage du mini-batch (ou tout le dataset) ──────────────────────
        if batch_size is not None and batch_size < len(data_list):
            indices = np.random.choice(len(data_list), size=batch_size, replace=False)
            batch   = [data_list[k] for k in indices]
        else:
            batch = data_list

        # ── Gradient sur le batch ───────────────────────────────────────────
        grads        = gradient(batch, reseaux)
        direction    = [-g for g in grads]
        eta          = 10 * eta
        grad_norm_sq = sum(np.sum(g ** 2) for g in grads)

        # ── Backtracking (condition d'Armijo évaluée sur le batch) ─────────
        """while True:
            reseaux_candidat = copy.deepcopy(reseaux)
            for i in range(len(reseaux["Theta"])):
                reseaux_candidat["Theta"][i] += eta * direction[i]

            candidate_cost = sum(mse(propa_globale(x, reseaux_candidat), y)
                                 for x, y in batch) / len(batch)

            if candidate_cost <= current_cost :
                break
            
            eta *= reduction"""
        if eta < 1e-10:
                if verbose:
                    print("Pas trop petit → abandon backtracking")
                break

        for i in range(len(reseaux["Theta"])):
            reseaux["Theta"][i] += eta * direction[i]

        # ── Coût complet (pour le tracé et la comparaison) ─────────────────
        current_cost = sum(mse(propa_globale(x, reseaux), y)
                           for x, y in data) / len(data)
        couts.append(current_cost)
        etas.append(eta)

        if verbose and it % 200 == 0:
            print(f"It {it:5d} | coût = {current_cost:.7f} | η utilisé = {eta:.6f}")

    # Tracés
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    ax1.plot(couts)
    ax1.set_yscale("log")
    ax1.set_xlabel("Itérations")
    ax1.set_ylabel("Coût (log)")
    ax1.grid(True, alpha=0.3)
    ax1.set_title("Évolution du coût — Diamonds")
    ax2.plot(etas, color="darkgreen")
    ax2.set_yscale("log")
    ax2.set_xlabel("Itérations")
    ax2.set_ylabel("η (log)")
    ax2.grid(True, alpha=0.3)
    ax2.set_title("Évolution du pas η")
    plt.tight_layout()
    plt.show()

    return reseaux, couts, etas

