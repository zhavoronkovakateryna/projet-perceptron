# ────────────────────────────────────────────────
# Génération des 32 theta0 Xavier
# ────────────────────────────────────────────────
def gen_theta_xavier(seed, dims=[(13,15),(15,15),(15,1)]):
    np.random.seed(seed)
    return [np.random.uniform(-np.sqrt(6/(i+o)), np.sqrt(6/(i+o)), (o, i+1))
            for (i,o) in dims]

theta0_list = [gen_theta_xavier(seed) for seed in range(32)]

